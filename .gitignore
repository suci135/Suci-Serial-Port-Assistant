# Python 字节码
__pycache__/
*.py[cod]
*$py.class

# 项目虚拟环境
/.venv/
/venv/
/env/
/ENV/

# 构建与安装输出
/build/
/dist/
/build_assets/
/installer_output/
*.egg-info/
*.issig

# 测试、覆盖率和代码检查缓存
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.tox/
/.nox/
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/

# 编辑器和本地工作区
/.idea/
/.vscode/
*.swp
*~

# 本地环境变量（示例文件可以提交）
.env
.env.*
!.env.example

# 日志和临时文件
*.log
/logs/
*.tmp
*.bak
*.orig
/.codex-preview/

# 操作系统元数据
